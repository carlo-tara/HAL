{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gold_set.schema.json",
  "title": "Gold set System 1 (HT-005)",
  "description": "Un caso per riga in JSONL. L'etichetta label è umana (HT-005); questo schema è il contratto validato da scripts/gold_set_scoring.py.",
  "type": "object",
  "required": ["id", "family", "instruction", "label"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "family": { "enum": ["choice", "routing", "score", "noul"] },
    "instruction": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "Obbligatorio per choice/routing; label deve esserne membro."
    },
    "criteria": {
      "type": "string",
      "description": "Obbligatorio per score (criterio di scoring System 1)."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "family": { "enum": ["choice", "routing"] } } },
      "then": { "required": ["candidates"] }
    },
    {
      "if": { "properties": { "family": { "const": "score" } } },
      "then": { "required": ["criteria"] }
    }
  ]
}
