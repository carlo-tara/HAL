  "response": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Sudoku</title>\n  <style>\n    :root {\n      color-scheme: light;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      background: #f1f5f9;\n      color: #172033;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      min-height: 100vh;\n      margin: 0;\n      display: grid;\n      place-items: center;\n      padding: 24px 14px;\n    }\n\n    main {\n      width: min(100%, 540px);\n      padding: 28px;\n      background: #fff;\n      border-radius: 20px;\n      box-shadow: 0 12px 40px #17203318;\n    }\n\n    h1 {\n      margin: 0 0 6px;\n      text-align: center;\n      font-size: clamp(1.8rem, 7vw, 2.5rem);\n    }\n\n    .instructions {\n      margin: 0 0 20px;\n      text-align: center;\n      color: #64748b;\n      line-height: 1.5;\n    }\n\n    #board {\n      display: grid;\n      grid-template-columns: repeat(9, minmax(0, 1fr));\n      width: 100%;\n      aspect-ratio: 1;\n      overflow: hidden;\n      border: 2px solid #26344b;\n      border-radius: 4px;\n      background: #fff;\n    }\n\n    .cell {\n      display: grid;\n      place-items: center;\n      min-width: 0;\n      padding: 0;\n      border: 1px solid #cbd5e1;\n      background: #fff;\n      color: #1761a0;\n      font: 500 clamp(1rem, 5.4vw, 1.8rem) / 1 system-ui, sans-serif;\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n    }\n\n    .cell:nth-child(3n) { border-right: 2px solid #26344b; }\n    .cell:nth-child(9n + 1) { border-left: 0; }\n    .cell:nth-child(n + 19):nth-child(-n + 27),\n    .cell:nth-child(n + 46):nth-child(-n + 54) {\n      border-bottom: 2px solid #26344b;\n    }\n    .cell:nth-child(-n + 9) { border-top: 0; }\n    .cell:nth-child(9n) { border-right: 0; }\n    .cell:nth-child(n + 73) { border-bottom: 0; }\n\n    .cell.given {\n      color: #172033;\n      font-weight: 750;\n    }\n\n    .cell.related { background: #f1f6fc; }\n    .cell.same-number { background: #dcecff; }\n    .cell.selected {\n      position: relative;\n      z-index: 1;\n      background: #b8d8fb;\n      box-shadow: inset 0 0 0 2px #2878c7;\n    }\n    .cell.error {\n      color: #b42318;\n      background: #fee4e2;\n    }\n    .cell:focus-visible {\n      position: relative;\n      z-index: 2;\n      outline: 3px solid #f59e0b;\n      outline-offset: -3px;\n    }\n\n    #message {\n      min-height: 1.5em;\n      margin: 14px 0;\n      text-align: center;\n      color: #475569;\n      font-size: 0.95rem;\n    }\n\n    #message.success {\n      color: #137547;\n      font-weight: 700;\n    }\n\n    .controls {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 8px;\n    }\n\n    .controls button {\n      min-width: 44px;\n      min-height: 42px;\n      padding: 8px 13px;\n      border: 1px solid #cbd5e1;\n      border-radius: 9px;\n      background: #f8fafc;\n      color: #172033;\n      font: inherit;\n      font-weight: 650;\n      cursor: pointer;\n    }\n\n    .controls button:hover { background: #e8f1fb; }\n    .controls button:focus-visible {\n      outline: 3px solid #2878c7;\n      outline-offset: 2px;\n    }\n\n    .controls .new-game {\n      margin-left: 8px;\n      border-color: #1761a0;\n      background: #1761a0;\n      color: #fff;\n    }\n\n    .controls .new-game:hover { background: #124d80; }\n\n    @media (max-width: 420px) {\n      main { padding: 18px 12px; }\n      .controls { gap: 6px; }\n      .controls button { min-width: 38px; padding: 7px 10px; }\n      .controls .new-game { margin-left: 0; }\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <h1>Sudoku</h1>\n    <p class=\"instructions\">Seleziona una cella e inserisci una cifra da 1 a 9.<br>\n      Puoi usare anche la tastiera; Canc o Backspace eliminano la cifra.</p>\n\n    <div id=\"board\" role=\"grid\" aria-label=\"Griglia Sudoku\"></div>\n    <p id=\"message\" aria-live=\"polite\">Buon divertimento!</p>\n\n    <div class=\"controls\" aria-label=\"Inserisci una cifra\">\n      <button type=\"button\" data-number=\"1\">1</button>\n      <button type=\"button\" data-number=\"2\">2</button>\n      <button type=\"button\" data-number=\"3\">3</button>\n      <button type=\"button\" data-number=\"4\">4</button>\n      <button type=\"button\" data-number=\"5\">5</button>\n      <button type=\"button\" data-number=\"6\">6</button>\n      <button type=\"button\" data-number=\"7\">7</button>\n      <button type=\"button\" data-number=\"8\">8</button>\n      <button type=\"button\" data-number=\"9\">9</button>\n      <button type=\"button\" id=\"erase\">Cancella</button>\n      <button type=\"button\" id=\"new-game\" class=\"new-game\">Nuova partita</button>\n    </div>\n  </main>\n\n  <script>\n    (() => {\n      const boardElement = document.getElementById(\"board\");\n      const messageElement = document.getElementById(\"message\");\n      const digits = [1, 2, 3, 4, 5, 6, 7, 8, 9];\n\n      let solution;\n      let puzzle;\n      let values;\n      let selected = null;\n\n      function shuffle(array) {\n        const result = array.slice();\n        for (let i = result.length - 1; i > 0; i--) {\n          const j = Math.floor(Math.random() * (i + 1));\n          [result[i], result[j]] = [result[j], result[i]];\n        }\n        return result;\n      }\n\n      function makeSolution() {\n        const rows = shuffle([0, 1, 2]).flatMap(band =>\n          shuffle([0, 1, 2]).map(row => band * 3 + row)\n        );\n        const columns = shuffle([0, 1, 2]).flatMap(stack =>\n          shuffle([0, 1, 2]).map(column => stack * 3 + column)\n        );\n        const shuffledDigits = shuffle(digits);\n\n        return rows.map(row =>\n          columns.map(column =>\n            shuffledDigits[(row * 3 + Math.floor(row / 3) + column) % 9]\n          )\n        );\n      }\n\n      function startGame() {\n        solution = makeSolution();\n        puzzle = solution.map(row => row.slice());\n\n        const positions = shuffle(Array.from({ length: 81 }, (_, i) => i));\n        positions.slice(0, 48).forEach(position => {\n          puzzle[Math.floor(position / 9)][position % 9] = 0;\n        });\n\n        values = puzzle.map(row => row.slice());\n        selected = null;\n        messageElement.textContent = \"Buon divertimento!\";\n        messageElement.classList.remove(\"success\");\n        render(false);\n      }\n\n      function render(focusSelected = false) {\n        boardElement.innerHTML = \"\";\n\n        const selectedValue = selected ? values[selected.row][selected.col] : 0;\n        let hasErrors = false;\n        let complete = true;\n\n        for (let row = 0; row < 9; row++) {\n          for (let col = 0; col < 9; col++) {\n            const value = values[row][col];\n            const isGiven = puzzle[row][col] !== 0;\n            const isSelected = selected?.row === row && selected?.col === col;\n            const isError = value !== 0 && value !== solution[row][col];\n\n            if (isError) hasErrors = true;\n            if (value !== solution[row][col]) complete = false;\n\n            const cell = document.createElement(\"button\");\n            cell.type = \"button\";\n            cell.className = \"cell\";\n            cell.dataset.row = row;\n            cell.dataset.col = col;\n            cell.setAttribute(\"role\", \"gridcell\");\n            cell.setAttribute(\n              \"aria-label\",\n              `Riga ${row + 1}, colonna ${col + 1}${value ? `, ${value}` : \", vuota\"}${isGiven ? \", cifra iniziale\" : \"\"}`\n            );\n            cell.setAttribute(\"aria-pressed\", String(isSelected));\n            cell.textContent = value || \"\";\n\n            if (isGiven) cell.classList.add(\"given\");\n            if (isSelected) cell.classList.add(\"selected\");\n            if (\n              selected &&\n              (selected.row === row || selected.col === col ||\n                (Math.floor(selected.row / 3) === Math.floor(row / 3) &&\n                 Math.floor(selected.col / 3) === Math.floor(col / 3)))\n            ) {\n              cell.classList.add(\"related\");\n            }\n            if (selectedValue && value === selectedValue) cell.classList.add(\"same-number\");\n            if (isError) cell.classList.add(\"error\");\n\n            boardElement.appendChild(cell);\n          }\n        }\n\n        if (complete) {\n          messageElement.textContent = \"Complimenti! Hai completato il Sudoku.\";\n          messageElement.classList.add(\"success\");\n        } else {\n          messageElement.textContent = hasErrors\n            ? \"Le cifre in rosso non corrispondono alla soluzione.\"\n            : \"Buon divertimento!\";\n          messageElement.classList.remove(\"success\");\n        }\n\n        if (focusSelected && selected) {\n          boardElement.querySelector(\n            `[data-row=\"${selected.row}\"][data-col=\"${selected.col}\"]`\n          )?.focus({ preventScroll: true });\n        }\n      }\n\n      function enterValue(value) {\n        if (!selected || puzzle[selected.row][selected.col] !== 0) return;\n        values[selected.row][selected.col] = value;\n        render(true);\n      }\n\n      boardElement.addEventListener(\"click\", event => {\n        const cell = event.target.closest(\".cell\");\n        if (!cell) return;\n\n        selected = {\n          row: Number(cell.dataset.row),\n          col: Number(cell.dataset.col)\n        };\n        render(true);\n      });\n\n      document.querySelector(\".controls\").addEventListener(\"click\", event => {\n        const numberButton = event.target.closest(\"[data-number]\");\n        if (numberButton) {\n          enterValue(Number(numberButton.dataset.number));\n        } else if (event.target.closest(\"#erase\")) {\n          enterValue(0);\n        } else if (event.target.closest(\"#new-game\")) {\n          startGame();\n        }\n      });\n\n      document.addEventListener(\"keydown\", event => {\n        if (!selected) return;\n\n        if (/^[1-9]$/.test(event.key)) {\n          event.preventDefault();\n          enterValue(Number(event.key));\n          return;\n        }\n\n        if (event.key === \"Backspace\" || event.key === \"Delete\" || event.key === \"0\") {\n          event.preventDefault();\n          enterValue(0);\n          return;\n        }\n\n        const moves = {\n          ArrowUp: [-1, 0],\n          ArrowDown: [1, 0],\n          ArrowLeft: [0, -1],\n          ArrowRight: [0, 1]\n        };\n\n        if (moves[event.key]) {\n          event.preventDefault();\n          const [dr, dc] = moves[event.key];\n          selected = {\n            row: (selected.row + dr + 9) % 9,\n            col: (selected.col + dc + 9) % 9\n          };\n          render(true);\n        }\n      });\n\n      startGame();\n    })();\n  </script>\n</body>\n</html>",
