  "response": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Sudoku</title>\n  <style>\n    :root {\n      color-scheme: light;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      color: #1e293b;\n      background: #f1f5f9;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      padding: 24px 14px;\n    }\n\n    main {\n      width: min(100%, 520px);\n      padding: 26px;\n      border-radius: 20px;\n      background: #fff;\n      box-shadow: 0 12px 40px rgb(15 23 42 / 10%);\n    }\n\n    h1 {\n      margin: 0;\n      text-align: center;\n      font-size: clamp(1.7rem, 6vw, 2.2rem);\n      letter-spacing: .04em;\n    }\n\n    .instructions {\n      margin: 8px 0 20px;\n      color: #64748b;\n      text-align: center;\n      font-size: .95rem;\n      line-height: 1.5;\n    }\n\n    .board {\n      display: grid;\n      grid-template-columns: repeat(9, 1fr);\n      width: 100%;\n      aspect-ratio: 1;\n      overflow: hidden;\n      border: 3px solid #334155;\n      border-radius: 4px;\n      background: #fff;\n    }\n\n    .cell {\n      display: grid;\n      place-items: center;\n      min-width: 0;\n      padding: 0;\n      border: 0;\n      border-right: 1px solid #cbd5e1;\n      border-bottom: 1px solid #cbd5e1;\n      border-radius: 0;\n      background: #fff;\n      color: #2563eb;\n      font: 500 clamp(1rem, 5vw, 1.65rem) / 1 system-ui, sans-serif;\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n    }\n\n    .cell.box-right { border-right: 3px solid #334155; }\n    .cell.row-bottom { border-bottom: 3px solid #334155; }\n    .cell.given { color: #1e293b; font-weight: 750; }\n    .cell.related { background: #f1f5f9; }\n    .cell.same-number { background: #dbeafe; }\n    .cell.conflict,\n    .cell.incorrect { background: #fee2e2; color: #b91c1c; }\n    .cell.selected {\n      position: relative;\n      z-index: 1;\n      background: #bfdbfe;\n      box-shadow: inset 0 0 0 3px #2563eb;\n    }\n    .cell.selected.conflict,\n    .cell.selected.incorrect {\n      background: #fecaca;\n      box-shadow: inset 0 0 0 3px #dc2626;\n    }\n    .cell:focus-visible { outline: 3px solid #0f172a; outline-offset: -4px; }\n\n    .status {\n      min-height: 1.5em;\n      margin: 16px 0 12px;\n      text-align: center;\n      color: #475569;\n      font-weight: 600;\n    }\n    .status.success { color: #15803d; }\n    .status.error { color: #b91c1c; }\n\n    .controls {\n      display: flex;\n      justify-content: center;\n      gap: 10px;\n      flex-wrap: wrap;\n    }\n\n    .controls button {\n      min-height: 44px;\n      padding: 10px 16px;\n      border: 0;\n      border-radius: 10px;\n      background: #2563eb;\n      color: white;\n      font: 650 1rem system-ui, sans-serif;\n      cursor: pointer;\n    }\n\n    .controls button.secondary { background: #e2e8f0; color: #1e293b; }\n    .controls button:hover { filter: brightness(.94); }\n    .controls button:focus-visible { outline: 3px solid #0f172a; outline-offset: 3px; }\n\n    .key-hint {\n      margin: 14px 0 0;\n      color: #64748b;\n      text-align: center;\n      font-size: .8rem;\n    }\n\n    @media (max-width: 420px) {\n      main { padding: 18px 12px; }\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <h1>Sudoku</h1>\n    <p class=\"instructions\">Completa la griglia con i numeri da 1 a 9: ogni riga, colonna e riquadro deve contenerli tutti una sola volta.</p>\n\n    <div id=\"board\" class=\"board\" role=\"grid\" aria-label=\"Griglia di Sudoku\"></div>\n\n    <p id=\"status\" class=\"status\" aria-live=\"polite\">Seleziona una cella e inserisci una cifra.</p>\n\n    <div class=\"controls\">\n      <button id=\"erase\" class=\"secondary\" type=\"button\">Cancella</button>\n      <button id=\"new-game\" type=\"button\">Nuova partita</button>\n    </div>\n\n    <p class=\"key-hint\">Tastiera: cifre 1–9, Canc o Backspace per cancellare, frecce per spostarti.</p>\n  </main>\n\n  <script>\n    (() => {\n      const SIZE = 9;\n      const CELLS_TO_REMOVE = 48;\n      const boardElement = document.getElementById(\"board\");\n      const statusElement = document.getElementById(\"status\");\n      const cells = [];\n\n      let solution = [];\n      let puzzle = [];\n      let selected = { row: 0, col: 0 };\n      let finished = false;\n\n      function shuffle(items) {\n        const result = items.slice();\n        for (let i = result.length - 1; i > 0; i--) {\n          const j = Math.floor(Math.random() * (i + 1));\n          [result[i], result[j]] = [result[j], result[i]];\n        }\n        return result;\n      }\n\n      function makeSolution() {\n        const bands = shuffle([0, 1, 2]);\n        const stacks = shuffle([0, 1, 2]);\n        const rows = bands.flatMap(band =>\n          shuffle([0, 1, 2]).map(offset => band * 3 + offset)\n        );\n        const cols = stacks.flatMap(stack =>\n          shuffle([0, 1, 2]).map(offset => stack * 3 + offset)\n        );\n        const digits = shuffle([1, 2, 3, 4, 5, 6, 7, 8, 9]);\n\n        return rows.map(row =>\n          cols.map(col => digits[(row * 3 + Math.floor(row / 3) + col) % 9])\n        );\n      }\n\n      function makePuzzle(answer) {\n        const result = answer.map(row => row.slice());\n        const positions = shuffle(Array.from({ length: 81 }, (_, i) => i));\n        for (let i = 0; i < CELLS_TO_REMOVE; i++) {\n          const position = positions[i];\n          result[Math.floor(position / 9)][position % 9] = 0;\n        }\n        return result;\n      }\n\n      function setStatus(message, kind = \"\") {\n        statusElement.textContent = message;\n        statusElement.className = `status${kind ? ` ${kind}` : \"\"}`;\n      }\n\n      function hasConflict(row, col, value) {\n        for (let i = 0; i < SIZE; i++) {\n          if (i !== col && puzzle[row][i] === value) return true;\n          if (i !== row && puzzle[i][col] === value) return true;\n        }\n\n        const startRow = Math.floor(row / 3) * 3;\n        const startCol = Math.floor(col / 3) * 3;\n        for (let r = startRow; r < startRow + 3; r++) {\n          for (let c = startCol; c < startCol + 3; c++) {\n            if ((r !== row || c !== col) && puzzle[r][c] === value) return true;\n          }\n        }\n        return false;\n      }\n\n      function updateBoard() {\n        const selectedValue = puzzle[selected.row][selected.col];\n\n        for (let row = 0; row < SIZE; row++) {\n          for (let col = 0; col < SIZE; col++) {\n            const index = row * SIZE + col;\n            const cell = cells[index];\n            const value = puzzle[row][col];\n            const isSelected = row === selected.row && col === selected.col;\n            const isGiven = value !== 0 && value === initialPuzzle[row][col];\n            const isIncorrect = value !== 0 && value !== solution[row][col];\n            const isConflict = value !== 0 && hasConflict(row, col, value);\n\n            cell.textContent = value === 0 ? \"\" : String(value);\n            cell.className = \"cell\";\n            if (col === 2 || col === 5) cell.classList.add(\"box-right\");\n            if (row === 2 || row === 5) cell.classList.add(\"row-bottom\");\n            if (isGiven) cell.classList.add(\"given\");\n            if ((row === selected.row || col === selected.col) ||\n                (Math.floor(row / 3) === Math.floor(selected.row / 3) &&\n                 Math.floor(col / 3) === Math.floor(selected.col / 3))) {\n              cell.classList.add(\"related\");\n            }\n            if (selectedValue !== 0 && value === selectedValue) {\n              cell.classList.add(\"same-number\");\n            }\n            if (isConflict) cell.classList.add(\"conflict\");\n            if (isIncorrect) cell.classList.add(\"incorrect\");\n            if (isSelected) cell.classList.add(\"selected\");\n\n            cell.tabIndex = isSelected ? 0 : -1;\n            const description = value === 0 ? \"vuota\" : `valore ${value}`;\n            cell.setAttribute(\n              \"aria-label\",\n              `Riga ${row + 1}, colonna ${col + 1}, ${description}${isGiven ? \", precompilata\" : \"\"}${isIncorrect || isConflict ? \", errore\" : \"\"}`\n            );\n          }\n        }\n      }\n\n      function checkCompletion() {\n        const complete = puzzle.every((row, r) =>\n          row.every((value, c) => value === solution[r][c])\n        );\n\n        if (complete) {\n          finished = true;\n          setStatus(\"Complimenti! Hai completato il Sudoku.\", \"success\");\n        } else {\n          finished = false;\n        }\n      }\n\n      function enterValue(value) {\n        if (finished) return;\n        if (initialPuzzle[selected.row][selected.col] !== 0) {\n          setStatus(\"Questa cella è precompilata.\");\n          return;\n        }\n\n        puzzle[selected.row][selected.col] = value;\n        updateBoard();\n        checkCompletion();\n\n        if (!finished) {\n          const current = puzzle[selected.row][selected.col];\n          if (current !== 0 && current !== solution[selected.row][selected.col]) {\n            setStatus(\"Valore errato: la cella è evidenziata in rosso.\", \"error\");\n          } else if (current !== 0 && hasConflict(selected.row, selected.col, current)) {\n            setStatus(\"C'è un numero ripetuto nella riga, colonna o riquadro.\", \"error\");\n          } else {\n            setStatus(\"Seleziona una cella e inserisci una cifra.\");\n          }\n        }\n      }\n\n      function clearSelected() {\n        if (finished || initialPuzzle[selected.row][selected.col] !== 0) return;\n        puzzle[selected.row][selected.col] = 0;\n        updateBoard();\n        setStatus(\"Valore cancellato.\");\n      }\n\n      function selectCell(row, col, moveFocus = false) {\n        selected = {\n          row: Math.max(0, Math.min(8, row)),\n          col: Math.max(0, Math.min(8, col))\n        };\n        updateBoard();\n        if (moveFocus) cells[selected.row * SIZE + selected.col].focus();\n      }\n\n      function newGame() {\n        solution = makeSolution();\n        puzzle = makePuzzle(solution);\n        initialPuzzle = puzzle.map(row => row.slice());\n        selected = { row: 0, col: 0 };\n        finished = false;\n        updateBoard();\n        setStatus(\"Nuova partita: buon divertimento!\");\n        cells[0].focus();\n      }\n\n      let initialPuzzle = [];\n\n      for (let row = 0; row < SIZE; row++) {\n        for (let col = 0; col < SIZE; col++) {\n          const cell = document.createElement(\"button\");\n          cell.type = \"button\";\n          cell.className = \"cell\";\n          cell.setAttribute(\"role\", \"gridcell\");\n          cell.addEventListener(\"click\", () => selectCell(row, col));\n          boardElement.appendChild(cell);\n          cells.push(cell);\n        }\n      }\n\n      boardElement.addEventListener(\"keydown\", event => {\n        const key = event.key;\n        if (/^[1-9]$/.test(key)) {\n          event.preventDefault();\n          enterValue(Number(key));\n          return;\n        }\n        if (key === \"Backspace\" || key === \"Delete\" || key === \"0\") {\n          event.preventDefault();\n          clearSelected();\n          return;\n        }\n\n        const moves = {\n          ArrowUp: [-1, 0],\n          ArrowDown: [1, 0],\n          ArrowLeft: [0, -1],\n          ArrowRight: [0, 1]\n        };\n        if (moves[key]) {\n          event.preventDefault();\n          selectCell(selected.row + moves[key][0], selected.col + moves[key][1], true);\n        }\n      });\n\n      document.getElementById(\"erase\").addEventListener(\"click\", clearSelected);\n      document.getElementById(\"new-game\").addEventListener(\"click\", newGame);\n\n      newGame();\n    })();\n  </script>\n</body>\n</html>",
