um > 9) {\n        return false;\n      }\n      let row = Math.floor(cella.parentNode.rowIndex / 9);\n      let col = Math.floor(cella.parentNode.cellIndex / 9);\n      for (let i = 0; i < 81; i++) {\n        if (soluzione[i] === null) {\n          let otherRow = Math.floor(i / 9);\n          let otherCol = i % 9;\n          if (otherRow === row && otherCol === col) {\n            continue;\n          }\n          if (otherRow === row || otherCol === col) {\n            if (soluzione[otherRow * 9 + otherCol] === num) {\n              return false;\n            }\n          }\n          if (\n            Math.floor(otherRow / 3) === Math.floor(row / 3) &&\n            Math.floor(otherCol / 3) === Math.floor(col / 3)\n          ) {\n            let quadratoRow = Math.floor(otherRow / 3) * 3;\n            let quadratoCol = Math.floor(otherCol / 3) * 3;\n            if (\n              otherRow >= row &&\n              otherRow < row + 3 &&\n              otherCol >= col &&\n              otherCol < col + 3\n            ) {\n              continue;\n            }\n            if (\n              otherRow === row &&\n              otherCol === col &&\n              cella.value !== \"\"\n            ) {\n              continue;\n            }\n            if (\n              otherRow === row ||\n              otherCol === col ||\n              (quadratoRow === row &&\n                quadratoCol === col) &&\n              cella.value !== \"\"\n            ) {\n              continue;\n            }\n          }\n        }\n      }\n      return true;\n    }\n\n    // Evento per selezionare una cella\n    document.querySelector(\"table\").addEventListener(\"click\", function (e) {\n      let cella = e.target;\n      if (cella.classList.contains(\"cella\")) {\n        if (cella.contentEditable === \"true\") {\n          selezionaCella(cella.value);\n        } else {\n          cancellaValore();\n        }\n      }\n    });\n\n    // Evento per inserire un numero\n    docum