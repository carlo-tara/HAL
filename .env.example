# HAL — Environment Configuration & Feature Flags

# Laya System 1 Defaults
LAYA_BASE_URL=http://laya.local:8091/v1
LAYA_TIMEOUT=10.0

# External LLM / OrcaRouter Feature Flags
# LLM_EXTERNAL_MODE: 0 = SPENTO (default: System 2 ACTIVE_MODEL_NAME), 1 = ATTIVO (OrcaRouter)
LLM_EXTERNAL_MODE=0
LLM_EXTERNAL_URI=https://api.orcarouter.com/v1

# Overrides per-agente (opzionali; ereditano da LLM_EXTERNAL_* se non definiti)
# a-agentzero
# A_AGENTZERO_LLM_EXTERNAL_MODE=0
# A_AGENTZERO_LLM_EXTERNAL_URI=https://api.orcarouter.com/v1
# A_AGENTZERO_LLM_EXTERNAL_MODEL=orcarouter/deepseek/deepseek-v4-flash-free

# a-b2b
# A_B2B_LLM_EXTERNAL_MODE=0
# A_B2B_LLM_EXTERNAL_MODEL=orcarouter/z-ai/glm-5.3-flash

# a-charts
# A_CHARTS_LLM_EXTERNAL_MODE=0
# A_CHARTS_LLM_EXTERNAL_MODEL=orcarouter/qwen/qwen3.8-flash

# a-copywriter
# A_COPYWRITER_LLM_EXTERNAL_MODE=0
# A_COPYWRITER_LLM_EXTERNAL_MODEL=orcarouter/openai/gpt-4o-mini

# a-enrichment
# A_ENRICHMENT_LLM_EXTERNAL_MODE=0
# A_ENRICHMENT_LLM_EXTERNAL_MODEL=orcarouter/deepseek/deepseek-v4-flash-free

# a-gherkin
# A_GHERKIN_LLM_EXTERNAL_MODE=0
