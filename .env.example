# A_JTBD_LLM_EXTERNAL_MODEL=orcarouter/openai/gpt-4o-mini

# a-personas
# A_PERSONAS_LLM_EXTERNAL_MODE=0
# A_PERSONAS_LLM_EXTERNAL_MODEL=orcarouter/openai/gpt-4o-mini

# a-po
