{
  "domain_slug": "example.it",
  "questions_file": "questions_example.txt",
  "project_url_template": "https://sznew.seozoom.it/project/view/{project_id}",
  "min_per_url_ok": 30,
  "per_url_optional": false,
  "subdirs": {
    "seozoom": "seozoom",
    "seozoom-competitor": "seozoom-competitor",
    "google": "google",
    "cloudflare": "cloudflare",
    "substack": "substack"
  },
  "critical_files": [
    "https___example.it_monitored.csv",
    "example_it_OnPageSEO.csv",
    "example.it_keyword_all.csv",
    "group_page_0.csv",
    "group_page_1_10.csv",
    "group_page_11_100.csv",
    "group_page_101_500.csv"
  ],
  "dashboard_subdir": "dashboard",
  "dashboard_files": [
    {"filename": "example.it_metriche.json", "widget": "metriche", "critical": false},
    {"filename": "example.it_andamento_dominio.json", "widget": "andamento_dominio", "critical": false},
    {"filename": "example.it_andamento_dominio_flat.csv", "widget": "andamento_dominio", "critical": false},
