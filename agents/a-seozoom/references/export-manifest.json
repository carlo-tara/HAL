    {"filename": "example.it_distribuzione_keyword_storica_flat.csv", "widget": "distribuzione_keyword_storica", "critical": false},
    {"filename": "example.it_andamento_annuale.csv", "widget": "andamento_annuale", "critical": false},
    {"filename": "example.it_backlink.csv", "widget": "backlink", "critical": false},
    {"filename": "example.it_backlink_summary.json", "widget": "backlink", "critical": false},
    {"filename": "example.it_pagine_competitor.csv", "widget": "pagine_competitor", "critical": false},
    {"filename": "example.it_previsione_traffico.json", "widget": "previsione_traffico", "critical": false},
    {"filename": "example.it_previsione_traffico_flat.csv", "widget": "previsione_traffico", "critical": false},
    {"filename": "example.it_posizionamento_monitorate.json", "widget": "posizionamento_monitorate", "critical": false},
    {"filename": "example.it_posizionamento_monitorate_flat.csv", "widget": "posizionamento_monitorate", "critical": false},
    {"filename": "example.it_andamento_keyword_progetto.json", "widget": "andamento_keyword_progetto", "critical": false},
    {"filename": "example.it_andamento_keyword_progetto_flat.csv", "widget": "andamento_keyword_progetto", "critical": false},
    {"filename": "example.it_idee_articoli.csv", "widget": "idee_articoli", "critical": false}
  ],
  "global_files": [
    {"filename": "example.it_keyword_all.csv", "api": "keyword/get-page-keywords", "page": "/project/view/keyword-studio/{pid}?tab=all"},
    {"filename": "example.it_LongTailKeywords.csv", "api": "keyword/get-longtail-keywords", "page": "/project/view/rankings/long-tail/{pid}"},
    {"filename": "example_it_OnPageSEO.csv", "api": "keyword/get-page-keywords", "page": "/project/view/keyword-studio/{pid}?tab=zero"},
    {"filename": "example_it_ContentGap.csv", "api": "domain/content-gap", "page": "/project/view/rankings/content-gap/{pid}"},
    {"filename": "example_it_ContentGap_AI.csv", "api": "domain/content-gap", "page": "/project/view/rankings/content-gap/{pid}", "filter": "informational"},
    {"filename": "example_it_PagesWithPotential.csv", "api": "pages/getpotentialpages", "page": "/project/view/pages/overview-contents/{pid}?tab=page-1-tab"},
    {"filename": "example_it_PagesWithMoreKeywords.csv", "api": "pages/getmainpages", "page": "/project/view/pages/overview-contents/{pid}?tab=page-3-tab"},
    {"filename": "example_it_PagesWithTrafficUp.csv", "api": "pages/growingpagesdash", "page": "/project/view/pages/overview-contents/{pid}?tab=page-4-tab"},
    {"filename": "example_it_PagesWithTrafficDown.csv", "api": "pages/decreasingpagedash", "page": "/project/view/pages/overview-contents/{pid}?tab=page-5-tab"},
    {"filename": "example_it_MainPages.csv", "api": "pages/getmainpages", "page": "/project/view/pages/overview-contents/{pid}?tab=page-2-tab"},
    {"filename": "example_it_NewEntry.csv", "api": "pages/getmainpages", "page": "/project/view/pages/overview-contents/{pid}?tab=page-6-tab"},
    {"filename": "example_it_Cannibalization.xlsx", "api": "pages/cannibalization", "page": "/project/view/pages/overview-contents/{pid}?tab=page-7-tab"},
    {"filename": "https___example.it_competitor.csv", "api": "domain-vs-domain/competition", "page": "/project/view/competitor/{pid}"},
    {"filename": "https___example.it_monitored.csv", "api": "project/getmonitoredkeyfull", "page": "/project/view/rankings/{pid}"},
    {"filename": "clusters_keyword.csv", "api": "domain/getClustersResearch", "page": "/project/view/rankings/clusters/{pid}"},
    {"filename": "keywords_cluster.csv", "api": "domain/getKeywordsClustersResearch", "page": "/project/view/rankings/clusters/{pid}"},
    {"filename": "group_page_0.csv", "api": "derived", "page": "/project/view/pages/overview-contents/{pid}?tab=page-0-tab"},
    {"filename": "group_page_1_10.csv", "api": "derived", "page": "/project/view/pages/overview-contents/{pid}?tab=page-0-tab"},
    {"filename": "group_page_11_100.csv", "api": "derived", "page": "/project/view/pages/overview-contents/{pid}?tab=page-0-tab"},
    {"filename": "group_page_101_500.csv", "api": "derived", "page": "/project/view/pages/overview-contents/{pid}?tab=page-0-tab"},
    {"filename": "questions_example.txt", "api": "domain/getFaq", "page": "/project/view/rankings/questions/{pid}"}
  ],
  "optional_analytics_files": [
    {"pattern": "gsc_queries_*.csv", "subdir": "google", "source": "gsc_export.py", "description": "GSC query+page performance"},
    {"pattern": "gsc_pages_*.csv", "subdir": "google", "source": "gsc_export.py", "description": "GSC landing page aggregates"},
    {"pattern": "ga4_landing_pages_*.csv", "subdir": "google", "source": "ga4_export.py", "description": "GA4 landing pages"},
    {"pattern": "ga4_organic_landing_*.csv", "subdir": "google", "source": "ga4_export.py", "description": "GA4 organic landing pages"},
    {"pattern": "ga4_exit_pages_*.csv", "subdir": "google", "source": "ga4_export.py", "description": "GA4 exit pages"},
    {"pattern": "ga4_events_*.csv", "subdir": "google", "source": "ga4_export.py", "description": "GA4 custom SEO events"},
    {"pattern": "cf_requests_*.csv", "subdir": "cloudflare", "source": "cf_analytics_export.py", "description": "Cloudflare requests by path/status"},
    {"pattern": "cf_404_*.csv", "subdir": "cloudflare", "source": "cf_analytics_export.py", "description": "Cloudflare 404 spikes"},
    {"pattern": "gtm_container_live_*.json", "subdir": "google", "source": "gtm_export.py", "description": "GTM live container snapshot"},
    {"pattern": "gtm_tags_*.csv", "subdir": "google", "source": "gtm_export.py", "description": "GTM tags summary"},
    {"pattern": "gtm_triggers_*.csv", "subdir": "google", "source": "gtm_export.py", "description": "GTM triggers summary"},
    {"pattern": "gtm_variables_*.csv", "subdir": "google", "source": "gtm_export.py", "description": "GTM dataLayer variables"}
  ]
}
